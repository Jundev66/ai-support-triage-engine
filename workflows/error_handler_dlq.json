{
  "id": "error_handler_dlq",
  "name": "Global Error Handler & Dead Letter Queue (DLQ)",
  "nodes": [
    {
      "parameters": {},
      "id": "error-trigger",
      "name": "Global Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO app_triage.dead_letter_queue (workflow_id, execution_id, error_message, error_node, error_stack, failed_payload) VALUES ($1, $2, $3, $4, $5, $6::jsonb) RETURNING id, created_at;",
        "additionalFields": {
          "queryParams": "={{ [$json.execution.workflowId || 'unknown_workflow', $json.execution.id || 'unknown_execution', $json.execution.error.message || 'Unknown error', $json.execution.error.node.name || 'Unknown node', $json.execution.error.stack || '', JSON.stringify($json.execution.data || {})] }}"
        }
      },
      "id": "insert-dlq-db",
      "name": "Insert into Dead Letter Queue",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [480, 300],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "Postgres Triage DB"
        }
      }
    }
  ],
  "connections": {
    "Global Error Trigger": {
      "main": [
        [
          {
            "node": "Insert into Dead Letter Queue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
