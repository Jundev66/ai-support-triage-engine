# System Environment & Secrets Template
# Copy to .env before starting services: cp .env.example .env

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_change_in_prod
POSTGRES_DB=n8n_triage
POSTGRES_PORT=5432

# n8n Configuration
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=generate_a_random_32_char_hex_key_here
WEBHOOK_URL=http://localhost:5678/

# Security & Triage Webhook Authentication
WEBHOOK_SECRET_TOKEN=secure_triage_webhook_bearer_token_xyz123

# LLM & Embedding Provider
OPENAI_API_KEY=your_openai_api_key_here
